# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# Supabase — from your project's API settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (Project Settings -> Database -> Connection string,
# URI, port 5432). Used for atomic admin transactions and migrations.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Shared secret for internal/service endpoints (outbox drain, sync, webhooks).
# Generate a long random value; required to enable those endpoints.
INTERNAL_API_SECRET=

# ClickUp integration (build-sequence step 3). API token drives the pull sync.
CLICKUP_API_TOKEN=
# Your ClickUp workspace (team) id.
CLICKUP_TEAM_ID=
# Comma-separated ClickUp space ids the hourly pull sync (/internal/sync/all) walks.
CLICKUP_SPACE_IDS=
# Only needed for the direct ClickUp->our-HMAC-webhook path (unused with the n8n/cron pull).
CLICKUP_WEBHOOK_SECRET=

