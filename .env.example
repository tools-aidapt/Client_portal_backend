# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# Self-hosted auth (JWT). Generate long random secrets, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# Supabase — from your project's API settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (Project Settings -> Database -> Connection string,
# URI, port 5432). Used for atomic admin transactions and migrations.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Shared secret for internal/service endpoints (outbox drain, sync, webhooks).
# Generate a long random value; required to enable those endpoints.
INTERNAL_API_SECRET=

# ClickUp integration (build-sequence step 3). API token drives the pull sync.
CLICKUP_API_TOKEN=
# Your ClickUp workspace (team) id.
CLICKUP_TEAM_ID=
# Comma-separated ClickUp space ids the hourly pull sync (/internal/sync/all) walks.
CLICKUP_SPACE_IDS=90127425952,90127516104
# Only needed for the direct ClickUp->our-HMAC-webhook path (unused with the n8n/cron pull).
CLICKUP_WEBHOOK_SECRET=


# Invitations: frontend base for the registration link + n8n webhook that sends it.
PORTAL_BASE_URL=https://portal.aidapt.co
N8N_INVITE_WEBHOOK_URL=

# n8n webhook the public Wishlist intake form posts to. POST /admin/wishlist
# (super-admin only) calls the same webhook server-side to create wishlist
# items on a client's behalf. No auth required on the n8n side.
N8N_WISHLIST_WEBHOOK_URL=

# Process-intake form the Onboarding page's "Open onboarding form" button opens.
# Unset = the button renders disabled.
ONBOARDING_FORM_URL=https://processonboarding.aidaptnow.com/onboarding

# Wishlist-request form the Wishlist page's "Submit a request" button opens.
# Requests are authored in ClickUp, never in the Portal: this form writes to the
# shared "ORG - Client - Wishlist" list and the item appears on the board at the
# next `POST /internal/sync/wishlist`. Unset = the button renders disabled.
WISHLIST_FORM_URL=https://processonboarding.aidaptnow.com/wishlist/

# Passwordless (OTP) sign-in — optional alternative to email/password login.
# If unset outside production, the code is logged instead of emailed.
N8N_OTP_WEBHOOK_URL=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Cross-app identity (Client Portal / LMS / Support Desk suite). Each is
# independently optional — unset means that one integration no-ops.
# LMS's own /auth/register expects this exact value as x-internal-secret;
# it is a DIFFERENT secret from this app's own INTERNAL_API_SECRET above.
LMS_URL=https://aidapt-lms-backend.onrender.com
LMS_INTERNAL_SECRET=
# LMS's frontend, for the SSO redirect (not built on their side yet — set this
# when it is). Deliberately separate from LMS_URL above, which is the backend.
LMS_FRONTEND_URL=https://aidapt-lms-frontend.onrender.com
# Support Desk's frontend — its /auth/callback page already exists and works.
# Shared with Support Desk's own REDIRECT_TOKEN_SECRET (both must match exactly).
SUPPORT_DESK_URL=https://aidapt-suppot-frontend.onrender.com
REDIRECT_TOKEN_SECRET=
# Support Desk's backend, for the server-to-server POST /api/auth/register
# call (its own PORTAL_INTERNAL_SECRET — both must be set to the same value).
SUPPORT_DESK_BACKEND_URL=https://aidapt-support-backend.onrender.com
SUPPORT_DESK_INTERNAL_SECRET=
