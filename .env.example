# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# Self-hosted auth (JWT). Generate long random secrets, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# Supabase — from your project's API settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (Project Settings -> Database -> Connection string,
# URI, port 5432). Used for atomic admin transactions and migrations.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Shared secret for internal/service endpoints (outbox drain, sync, webhooks).
# Generate a long random value; required to enable those endpoints.
INTERNAL_API_SECRET=

# ClickUp integration (build-sequence step 3). API token drives the pull sync.
CLICKUP_API_TOKEN=
# Your ClickUp workspace (team) id.
CLICKUP_TEAM_ID=
# Comma-separated ClickUp space ids the hourly pull sync (/internal/sync/all) walks.
CLICKUP_SPACE_IDS=90127425952,90127516104
# Only needed for the direct ClickUp->our-HMAC-webhook path (unused with the n8n/cron pull).
CLICKUP_WEBHOOK_SECRET=


# Invitations: frontend base for the registration link + n8n webhook that sends it.
PORTAL_BASE_URL=https://portal.aidapt.co
N8N_INVITE_WEBHOOK_URL=

# Process-intake form the Onboarding page's "Open onboarding form" button opens.
# Unset = the button renders disabled.
ONBOARDING_FORM_URL=https://processonboarding.aidaptnow.com/onboarding

# Wishlist-request form the Wishlist page's "Submit a request" button opens.
# Requests are authored in ClickUp, never in the Portal: this form writes to the
# shared "ORG - Client - Wishlist" list and the item appears on the board at the
# next `POST /internal/sync/wishlist`. Unset = the button renders disabled.
WISHLIST_FORM_URL=https://processonboarding.aidaptnow.com/wishlist/

# Passwordless (OTP) sign-in — optional alternative to email/password login.
# If unset outside production, the code is logged instead of emailed.
N8N_OTP_WEBHOOK_URL=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
